digraph DFA {
  rankdir=LR;
  node [shape=circle];
  __start [shape=point];
  __start -> s0;
  s0 [label="S0", shape=circle];
  s1 [label="L1", shape=circle];
  s2 [label="L2", shape=circle];
  s3 [label="P0", shape=circle];
  s4 [label="P1", shape=circle];
  s5 [label="Q0", shape=circle];
  s6 [label="P2", shape=circle];
  s7 [label="Ql1", shape=circle];
  s8 [label="Qh", shape=circle];
  s9 [label="Ql2", shape=doublecircle];
  s10 [label="Qd", shape=circle];
  s0 -> s1 [label="letter, digit"];
  s1 -> s1 [label="letter, digit"];
  s1 -> s2 [label="dot, underscore, hyphen"];
  s1 -> s3 [label="at"];
  s2 -> s1 [label="letter, digit"];
  s3 -> s4 [label="letter, digit"];
  s4 -> s4 [label="letter, digit"];
  s4 -> s5 [label="dot"];
  s4 -> s6 [label="hyphen"];
  s5 -> s7 [label="letter"];
  s5 -> s8 [label="digit"];
  s6 -> s4 [label="letter, digit"];
  s6 -> s6 [label="hyphen"];
  s7 -> s9 [label="letter"];
  s7 -> s8 [label="digit"];
  s7 -> s5 [label="dot"];
  s7 -> s10 [label="hyphen"];
  s8 -> s8 [label="letter, digit"];
  s8 -> s5 [label="dot"];
  s8 -> s10 [label="hyphen"];
  s9 -> s9 [label="letter"];
  s9 -> s8 [label="digit"];
  s9 -> s5 [label="dot"];
  s9 -> s10 [label="hyphen"];
  s10 -> s8 [label="letter, digit"];
  s10 -> s10 [label="hyphen"];
}
